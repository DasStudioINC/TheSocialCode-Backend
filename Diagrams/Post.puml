@startuml
title Post Context
skinparam class {
     BackgroundColor<<Aggregate Root>> #FFE0B2
      BorderColor<<Aggregate Root>> #E65100

      BackgroundColor<<Entity>> #C8E6C9
      BorderColor<<Entity>> #2E7D32

      BackgroundColor<<Value Object>> #B3E5FC
      BorderColor<<Value Object>> #01579B
}

class Post <<Aggregate Root>>{
    - id : Long
    - userHandle : String
    - postNumber : int
    - postDirectories : PostDirectories
    - searchTitle : String
    - postData : PostData
    - poastDate : LocalDate
}

class PostData <<Value Object>>{
    - likeCount : int
    - viewCount : int
    - postName : String
    - description : String
}

class PostDirectories <<Value Object>>{
    - postPath : String
    - interactionPath : String
}


Post *-- PostData
Post *-- PostDirectories


legend right
  |= Color |= Element |
  |<#FFE0B2> | **Aggregate Root** |
  |<#C8E6C9> | **Entity** |
  |<#B3E5FC> | **Value Object** |
  |<#F5F5F5> | **Enumeration** |
  --
  <color:#E65100>Aggregate Root:</color>
  The entry point to an aggregate and the only
  object referenced from outside the aggregate.
  --
  <color:#01579B>Value Object:</color>
  An immutable object defined by its values,
  without an independent identity.
endlegend
@enduml