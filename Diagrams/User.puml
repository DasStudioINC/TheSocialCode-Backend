@startuml
title User Context

skinparam class {
     BackgroundColor<<Aggregate Root>> #FFE0B2
      BorderColor<<Aggregate Root>> #E65100

      BackgroundColor<<Entity>> #C8E6C9
      BorderColor<<Entity>> #2E7D32

      BackgroundColor<<Value Object>> #B3E5FC
      BorderColor<<Value Object>> #01579B
}

class User <<Aggregate Root>>{
    -user_handle : UserHandle
    -user_name : UserName
    -user_profile_picture : ProfilePicture
    -email : EmailAddress
    -userInfo : UserInfo
    -user_account_data : AccountData
    -user_creation_date : CreationDate
    -user_subscription_type : SubscriptionType
}

class UserHandle <<Value Object>> {
    - user_handle : String;
}

class ProfilePicture <<Value Object>> {
    - user_profile_picture : String
}

class UserInfo <<Value Object>> {
    - first_name : String
    - last_name : String
    - password : String
    - description : String
    ---
    + FullName() : String
}

class UserName <<Value Object>>{
    - user_name : String
}

class CreationDate <<Value Object>>{
   - create_date : LocalDate
}

class AccountData <<Value Object>> {
    - follower_count : int
    - post_count : int
    - literalPostCount : int
}

class EmailAddress <<Value Object>> {
    email : String
}

enum SubscriptionType{
    PREMIUM,
    BASIC
}

User *-- SubscriptionType
User *-- UserName
User *-- UserHandle
User *-- CreationDate
User *-- UserInfo
User *-- ProfilePicture
User *-- AccountData
User *-- EmailAddress

legend right
  |= Color |= Element |
  |<#FFE0B2> | **Aggregate Root** |
  |<#C8E6C9> | **Entity** |
  |<#B3E5FC> | **Value Object** |
  |<#F5F5F5> | **Enumeration** |
  --
  <color:#E65100>Aggregate Root:</color>
  The entry point to an aggregate and the only
  object referenced from outside the aggregate.
  --
  <color:#01579B>Value Object:</color>
  An immutable object defined by its values,
  without an independent identity.
endlegend

@enduml